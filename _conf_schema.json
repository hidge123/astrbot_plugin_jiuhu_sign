{
    "sign_config":
    {
        "description": "签到功能相关配置",
        "type": "object",
        "items": 
        {
            "infinite_credit":
            {
                "description": "无限饼干模式",
                "hint": "任何需要饼干(credit)的功能都直接成功",
                "type": "bool",
                "default": false
            }
        }
    },

    "tarot_config":
    {
        "description": "塔罗牌相关配置",
        "type": "object",
        "hint": "",
        "items":
        {
            "llm_provider_id":
            {
                "description": "LLM模型ID",
                "hint": "用于解析抽取塔罗牌含义的模型提供商id(为空使用astrbot默认对话模型)",
                "type": "string",
                "_special": "select_provider",
                "default": ""
            },

            "llm_prompt":
            {
                "description": "请求提示词",
                "hint": "用于请求模型的提示词(塔罗牌信息会动态的拼接到该提示词之后)",
                "type": "text",
                "default": "请跟据以下抽到的塔罗牌类型和含义给出占卜结果, 注意回复要简洁, 保持在一两句话之内, 回复风格与给出的含义解释保持一致"
            },

            "fix_random":
            {
                "description": "固定每天结果",
                "hint": "如果为真, 则每个用户同一天抽到的牌保持不变",
                "type": "bool",
                "default": false
            }
        }
    },

    "fortune_config":
    {
        "description": "今日运势相关配置",
        "type": "object",
        "hint": "",
        "items":
        {
            "delay_time":
            {
                "description": "图片缓存时间",
                "type": "object",
                "hint": "",
                "items":
                {
                    "avatar":
                    {
                        "description": "用户头像的缓存时间",
                        "hint": "",
                        "type": "int",
                        "default": 60
                    },

                    "output":
                    {
                        "description": "生成运势卡片的缓存时间",
                        "hint": "",
                        "type": "int",
                        "default": 60
                    }
                }
            },

            "probability":
            {
                "description": "概率",
                "hint": "调整个运势等级出现的概率",
                "type": "object",
                "items":
                {
                    "ji":
                    {
                        "description": "吉的概率",
                        "type": "int",
                        "default": 10,
                        "slider": {"min": 1, "max": 10, "step": 1}
                    },

                    "ping":
                    {
                        "description": "平的概率",
                        "type": "int",
                        "default": 10,
                        "slider": {"min": 1, "max": 10, "step": 1}
                    },

                    "xiong":
                    {
                        "description": "凶的概率",
                        "type": "int",
                        "default": 10,
                        "slider": {"min": 1, "max": 10, "step": 1}
                    }
                }
            },

            "fix_random":
            {
                "description": "固定每天结果",
                "hint": "如果为真, 则每个用户同一天抽到的运势结果保持不变",
                "type": "bool",
                "default": false
            }
        }
    },

    "other_config":
    {
        "description": "其他配置",
        "type": "object",
        "items":
        {
            "debug_mode":
            {
                "description": "调试模式",
                "hint": "是否启用详细的调试信息",
                "type": "bool",
                "default": false
            }
        }
    }
}